msgstr "Без перевіреної копії в сховищі:"

#: includes/class-simple-storage-jobs.php:1765
msgid "Files in the storage:"
msgstr "Файлів у сховищі:"

#: includes/class-simple-storage-jobs.php:1766
msgid "The same file in WordPress:"
msgstr "Той самий файл є у WordPress:"

#: includes/class-simple-storage-jobs.php:1812
msgid "Connect anyway"
msgstr "Усе одно підключити"

#: includes/class-simple-storage-jobs.php:1812
msgid "Switch anyway"
msgstr "Усе одно перемкнути"

#: includes/class-simple-storage-jobs.php:1814
msgid "The site will serve what the storage has. Files that are missing stay broken until they are uploaded.\n\nConnect anyway?"
msgstr "Сайт віддаватиме те, що є в сховищі. Відсутні файли не показуватимуться, доки їх не зальють.\n\nУсе одно підключити?"

#: includes/class-simple-storage-jobs.php:1815
msgid "The site will serve its files from WordPress. Files that are missing stay broken until they are uploaded.\n\nSwitch anyway?"
msgstr "Сайт віддаватиме файли з WordPress. Відсутні файли не показуватимуться, доки їх не зальють.\n\nУсе одно перемкнути?"

#. translators: 1: number of files, 2: folder.
#: includes/class-simple-storage-media.php:405
#, php-format
msgid "Automatically moved %1$d new files from %2$s to the storage."
msgstr "Автоматично перенесено в сховище нових файлів із %2$s: %1$d."

#. translators: %s: folder.
#: includes/class-simple-storage-media.php:457
#, php-format
msgid "Moving the files of %s to the storage was cut short several times in a row; it is tried again with the next change in that folder."
msgstr "Перенесення файлів %s у сховище кілька разів поспіль обривалося; наступна спроба — з наступною зміною в цій теці."

#. translators: %s: file path.
#: includes/class-simple-storage-media.php:554
