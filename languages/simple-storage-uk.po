msgstr "Видалення копій у сховищі"

#: includes/class-simple-storage-jobs.php:1719
msgid "Removing empty storage folders"
msgstr "Видалення порожніх тек у сховищі"

#: includes/class-simple-storage-jobs.php:1721
msgid "Comparing with the Media Library"
msgstr "Звірка з медіатекою"

#: includes/class-simple-storage-jobs.php:1723
msgid "Matching files at the same paths"
msgstr "Звірка однойменних файлів"

#: includes/class-simple-storage-jobs.php:1724
