#. Plugin Name of the plugin
#: simple-storage.php
#: includes/class-simple-storage-admin.php:30
#: includes/class-simple-storage-admin.php:31
#: includes/class-simple-storage-admin.php:169
msgid "Simple Storage"
msgstr "Simple Storage"

#. Description of the plugin
#: simple-storage.php
msgid "Moves WordPress media files to the Hosting Ukraine storage and back, with verification and serving from the storage."
msgstr "Переносить медіафайли WordPress у сховище Хостинг Україна й назад, з перевіркою та віддачею зі сховища."

#. Author of the plugin
#: simple-storage.php
msgid "Vitalii Kaplia"
msgstr "Віталій Капля"

#. Author URI of the plugin
#: simple-storage.php
msgid "https://kaplia.pro/"
msgstr "https://kaplia.pro/"

#: includes/class-simple-storage-admin.php:50
msgid "Open"
msgstr "Відкрити"

#. translators: %s: job name.
#: includes/class-simple-storage-admin.php:147
#, php-format
msgid "Simple Storage: \"%s\" is not finished."
msgstr "Simple Storage: «%s» не завершено."

#: includes/class-simple-storage-admin.php:149
#: includes/class-simple-storage-admin.php:429
msgid "Continue"
msgstr "Продовжити"

#: includes/class-simple-storage-admin.php:155
msgid "Sorry, you are not allowed to access this page."
msgstr "Вибачте, у вас немає доступу до цієї сторінки."

#: includes/class-simple-storage-admin.php:160
msgid "Overview"
msgstr "Огляд"

#: includes/class-simple-storage-admin.php:161
#: includes/class-simple-storage-tester.php:41
#: includes/views/overview.php:92
msgid "Settings"
msgstr "Налаштування"

#: includes/class-simple-storage-admin.php:162
#: includes/views/log.php:17
msgid "Log"
msgstr "Журнал"

#: includes/class-simple-storage-admin.php:177
msgid "Simple Storage supports single-site WordPress installations only."
msgstr "Simple Storage працює лише на звичайних (не мультисайтових) встановленнях WordPress."

#. translators: %s: number of files.
#: includes/class-simple-storage-admin.php:198
#, php-format
msgid "%s file"
msgid_plural "%s files"
msgstr[0] "%s файл"
msgstr[1] "%s файли"
msgstr[2] "%s файлів"

#: includes/class-simple-storage-admin.php:277
msgid "Running"
msgstr "Виконується"

#: includes/class-simple-storage-admin.php:278
msgid "Paused"
msgstr "Призупинено"

#: includes/class-simple-storage-admin.php:279
msgid "Stopped by an error"
msgstr "Зупинено через помилку"

#: includes/class-simple-storage-admin.php:280
msgid "Finished"
msgstr "Завершено"

#: includes/class-simple-storage-admin.php:281
msgid "Cancelled"
msgstr "Скасовано"

#: includes/class-simple-storage-admin.php:300
msgid "Sorry, you are not allowed to do that."
msgstr "Вибачте, у вас немає прав на цю дію."

#: includes/class-simple-storage-admin.php:303
msgid "The page has expired. Reload it and try again."
msgstr "Сторінка застаріла. Перезавантажте її та спробуйте ще раз."

#: includes/class-simple-storage-admin.php:352
msgid "Unknown action."
msgstr "Невідома дія."

#: includes/class-simple-storage-admin.php:373
#: includes/class-simple-storage-client.php:44
#: includes/class-simple-storage-delivery.php:211
#: includes/class-simple-storage-jobs.php:71
msgid "The storage connection is not configured."
msgstr "Підключення до сховища не налаштовано."

#: includes/class-simple-storage-admin.php:394
msgid "The check applies to the transparent proxy while serving from the storage is on."
msgstr "Перевірка стосується прозорого проксі й можлива, коли віддачу зі сховища ввімкнено."

#: includes/class-simple-storage-admin.php:424
msgid "All media files will be copied to the storage and verified, serving from the storage will be enabled, and then the local copies will be deleted from WordPress.\n\nContinue?"
msgstr "Усі медіафайли буде скопійовано в сховище й перевірено, буде ввімкнено віддачу зі сховища, а потім локальні копії буде видалено з WordPress.\n\nПродовжити?"

#: includes/class-simple-storage-admin.php:425
msgid "All files will be downloaded from the storage back into WordPress, verified, and then deleted from the storage.\n\nContinue?"
msgstr "Усі файли буде завантажено зі сховища назад у WordPress, перевірено, а потім видалено зі сховища.\n\nПродовжити?"

#: includes/class-simple-storage-admin.php:426
msgid "Cancel the job? Files that were already processed stay where they are now."
msgstr "Скасувати задачу? Уже оброблені файли лишаться там, де вони зараз."

#: includes/class-simple-storage-admin.php:427
msgid "Some files exist only in the storage. If serving from the storage is turned off, they will not be shown on the site.\n\nTurn it off anyway?"
msgstr "Частина файлів є лише в сховищі. Якщо вимкнути віддачу зі сховища, сайт їх не показуватиме.\n\nВсе одно вимкнути?"

#: includes/class-simple-storage-admin.php:428
msgid "Pause"
msgstr "Призупинити"

#: includes/class-simple-storage-admin.php:430
msgid "Cancel"
msgstr "Скасувати"

#: includes/class-simple-storage-admin.php:431
msgid "Hide"
msgstr "Сховати"

#: includes/class-simple-storage-admin.php:432
msgid "files"
msgstr "файлів"

#: includes/class-simple-storage-admin.php:433
msgid "folders"
msgstr "тек"

#: includes/class-simple-storage-admin.php:434
msgid "failed"
msgstr "з помилкою"

#: includes/class-simple-storage-admin.php:435
msgid "Now:"
msgstr "Зараз:"

#: includes/class-simple-storage-admin.php:436
msgid "Started:"
msgstr "Почато:"

#: includes/class-simple-storage-admin.php:437
msgid "Finished:"
msgstr "Завершено:"

#: includes/class-simple-storage-admin.php:438
msgid "The server did not respond. The job is paused; continue it when the connection is back."
msgstr "Сервер не відповів. Задачу призупинено — продовжіть її, коли з’єднання відновиться."

#: includes/class-simple-storage-admin.php:439
msgid "Keep this tab open while the job runs. If you close it, the job pauses and can be continued later."
msgstr "Не закривайте цю вкладку, поки задача виконується. Якщо закрити, задача призупиниться, і її можна буде продовжити пізніше."

#: includes/class-simple-storage-admin.php:440
msgid "On"
msgstr "Увімкнено"

#: includes/class-simple-storage-admin.php:441
msgid "Off"
msgstr "Вимкнено"

#: includes/class-simple-storage-admin.php:442
msgid "Enable serving from the storage"
msgstr "Увімкнути віддачу зі сховища"

#: includes/class-simple-storage-admin.php:443
msgid "Disable serving from the storage"
msgstr "Вимкнути віддачу зі сховища"

#: includes/class-simple-storage-admin.php:444
msgid "The rules are written to uploads/.htaccess."
msgstr "Правила записано в uploads/.htaccess."

#: includes/class-simple-storage-admin.php:445
msgid "The rules are not in uploads/.htaccess; missing files are served only if the server passes such requests to WordPress."
msgstr "Правил немає в uploads/.htaccess: відсутні файли віддаються, лише якщо сервер передає такі запити у WordPress."

#: includes/class-simple-storage-admin.php:446
msgid "The rules in uploads/.htaccess are outdated; save the settings to refresh them."
msgstr "Правила в uploads/.htaccess застаріли — збережіть налаштування, щоб оновити їх."

#: includes/class-simple-storage-admin.php:447
msgid "transparent proxy, addresses unchanged"
msgstr "прозорий проксі, адреси не змінюються"

#: includes/class-simple-storage-admin.php:448
msgid "Proxy: Apache serves the files itself, without PHP"
msgstr "Проксі: Apache віддає файли сам, без PHP"

#: includes/class-simple-storage-admin.php:449
msgid "Proxy: the proxy.php script (Apache cannot proxy to the storage on this server)"
msgstr "Проксі: скрипт proxy.php (Apache на цьому сервері не може проксувати до сховища)"

#: includes/class-simple-storage-admin.php:450
msgid "Check the proxy engine again"
msgstr "Перевірити спосіб проксі ще раз"

#: includes/class-simple-storage-admin.php:451
msgid "Checking…"
msgstr "Перевірка…"

#: includes/class-simple-storage-admin.php:452
msgid "checked"
msgstr "перевірено"

#: includes/class-simple-storage-admin.php:453
msgid "Serving verified for:"
msgstr "Віддачу перевірено для:"

#: includes/class-simple-storage-admin.php:454
msgid "Serving is not verified for the current settings yet, so new uploads stay in WordPress. Save the settings or move the files to run the check."
msgstr "Віддачу ще не перевірено для поточних налаштувань, тому нові файли лишаються у WordPress. Збережіть налаштування або запустіть перенесення, щоб виконати перевірку."

#: includes/class-simple-storage-admin.php:455
msgid "directly from the storage"
msgstr "напряму зі сховища"

#: includes/class-simple-storage-admin.php:456
msgid "New uploads are moved to the storage automatically."
msgstr "Нові файли автоматично переносяться в сховище."

#: includes/class-simple-storage-admin.php:457
msgid "New uploads stay in WordPress."
msgstr "Нові файли лишаються у WordPress."

#: includes/class-simple-storage-admin.php:458
msgid "Testing…"
msgstr "Перевірка…"

#: includes/class-simple-storage-admin.php:459
msgid "Connection works."
msgstr "З’єднання працює."

#: includes/class-simple-storage-admin.php:460
msgid "Connection test failed."
msgstr "Перевірка з’єднання не вдалася."

#: includes/class-simple-storage-admin.php:461
msgid "never"
msgstr "ще не було"

#: includes/class-simple-storage-admin.php:462
msgid "Not tested yet"
msgstr "Ще не перевірялося"

#: includes/class-simple-storage-admin.php:463
#: includes/views/log.php:48
msgid "No errors."
msgstr "Помилок немає."

#: includes/class-simple-storage-admin.php:464
msgid "A job is running. Leaving the page pauses it."
msgstr "Задача виконується. Якщо піти зі сторінки, вона призупиниться."

#: includes/class-simple-storage-admin.php:465
msgid "The job is being processed in another tab, request or WP-CLI; this page follows its progress."
msgstr "Задачу зараз виконує інша вкладка, запит або WP-CLI — ця сторінка стежить за її прогресом."

#: includes/class-simple-storage-client.php:41
msgid "The PHP cURL extension is required."
msgstr "Потрібне розширення PHP cURL."

#: includes/class-simple-storage-client.php:137
msgid "Authorization failed. Check the storage address, login and password."
msgstr "Не вдалося авторизуватися. Перевірте адресу сховища, логін і пароль."

#: includes/class-simple-storage-client.php:144
msgid "The storage did not return an access token."
msgstr "Сховище не повернуло токен доступу."

#: includes/class-simple-storage-client.php:196
#: includes/class-simple-storage-client.php:603
msgid "The local file cannot be read."
msgstr "Не вдається прочитати локальний файл."

#: includes/class-simple-storage-client.php:293
msgid "The directory does not exist in the storage."
msgstr "Такого каталогу в сховищі немає."

#: includes/class-simple-storage-client.php:314
#: includes/class-simple-storage-prune.php:173
msgid "The storage returned a directory listing that cannot be read."
msgstr "Сховище повернуло список каталогу, який не вдається прочитати."

#: includes/class-simple-storage-client.php:438
msgid "The local file cannot be written."
msgstr "Не вдається записати локальний файл."

#. translators: %s: cURL error message.
#: includes/class-simple-storage-client.php:636
#, php-format
msgid "Storage request failed: %s"
msgstr "Запит до сховища не вдався: %s"

#: includes/class-simple-storage-client.php:703
#: includes/class-simple-storage-delivery.php:339
msgid "Unexpected storage response."
msgstr "Неочікувана відповідь сховища."

#. translators: 1: HTTP status code, 2: error description.
#: includes/class-simple-storage-client.php:709
#, php-format
msgid "Storage answered %1$d: %2$s"
msgstr "Сховище відповіло %1$d: %2$s"

#: includes/class-simple-storage-delivery.php:216
msgid "Serving from the storage was enabled."
msgstr "Віддачу зі сховища ввімкнено."

#: includes/class-simple-storage-delivery.php:237
msgid "Serving from the storage was disabled."
msgstr "Віддачу зі сховища вимкнено."

#: includes/class-simple-storage-delivery.php:316
msgid "Serving from the storage is off."
msgstr "Віддачу зі сховища вимкнено."

#. translators: 1: URL, 2: HTTP status code.
#: includes/class-simple-storage-delivery.php:389
#, php-format
msgid "A file that exists only in the storage is not served at its site address %1$s (answer %2$d). Check that the uploads/.htaccess rules work or that the server passes missing files to WordPress, and that the proxy configuration next to the plugins folder could be written."
msgstr "Файл, який є лише в сховищі, не віддається за адресою сайту %1$s (відповідь %2$d). Перевірте, що правила в uploads/.htaccess працюють або що сервер передає відсутні файли у WordPress, і що конфігурацію проксі поруч із текою plugins вдалося записати."

#. translators: %s: file path.
#: includes/class-simple-storage-delivery.php:475
#, php-format
msgid "Could not write %s; the transparent proxy cannot work without it."
msgstr "Не вдалося записати %s — без нього прозорий проксі не працюватиме."

#: includes/class-simple-storage-delivery.php:650
msgid "Transparent proxy: Apache cannot proxy to the storage here, so proxy.php serves the files."
msgstr "Прозорий проксі: Apache тут не може проксувати до сховища, тому файли віддає proxy.php."

#. translators: %s: engine name.
#: includes/class-simple-storage-delivery.php:652
#, php-format
msgid "Transparent proxy: Apache serves the files itself (%s), no PHP is involved."
msgstr "Прозорий проксі: Apache віддає файли сам (%s), без участі PHP."

#. translators: %s: file path.
#: includes/class-simple-storage-delivery.php:672
#, php-format
msgid "Could not write the rules to %s. Missing files are then served only where the server passes such requests to WordPress."
msgstr "Не вдалося записати правила в %s. Тоді відсутні файли віддаються лише там, де сервер передає такі запити у WordPress."

#: includes/class-simple-storage-github-updater.php:102
msgid "Moves WordPress media files to the Hosting Ukraine storage and back, with verification, and serves them from the storage either under their original addresses (transparent proxy) or directly."
msgstr "Переносить медіафайли WordPress у сховище Хостинг Україна й назад, з перевіркою, і віддає їх зі сховища — або за початковими адресами (прозорий проксі), або напряму."

#: includes/class-simple-storage-github-updater.php:103
msgid "Version 0.3.3: new files go to the storage and leave the disk at the end of the request that wrote them, and folders left empty in the storage are removed at the end of the request that deleted the files, without waiting for other requests; with a background image optimizer the local copies wait for it. Version 0.3.2: folders that deleting files leaves empty in the storage are removed too, safely, under the job lock."
msgstr "Версія 0.3.3: нові файли переносяться в сховище й зникають з диска наприкінці запиту, що їх записав, а теки, що лишились у сховищі порожніми, прибираються наприкінці запиту, що видалив файли, — без очікування інших запитів; з фоновим оптимізатором зображень локальні копії чекають, поки він закінчить. Версія 0.3.2: теки, які після видалення файлів лишаються в сховищі порожніми, теж видаляються — безпечно, під блокуванням задач."

#: includes/class-simple-storage-index.php:206
msgid "Name conflict: a different local file appeared where a file that lives only in the storage is recorded. Both were kept; rename or remove one of them and index again."
msgstr "Конфлікт імен: на місці файлу, який є лише в сховищі, з’явився інший локальний файл. Обидва збережено; перейменуйте або видаліть один із них і проіндексуйте знову."

#: includes/class-simple-storage-jobs.php:65
msgid "Unknown job."
msgstr "Невідома задача."

#: includes/class-simple-storage-jobs.php:68
msgid "Another job is not finished yet. Continue or cancel it first."
msgstr "Інша задача ще не завершена. Спершу продовжте або скасуйте її."

#: includes/class-simple-storage-jobs.php:106
msgid "started."
msgstr "розпочато."

#: includes/class-simple-storage-jobs.php:115
msgid "There is no paused job."
msgstr "Немає призупиненої задачі."

#: includes/class-simple-storage-jobs.php:139
msgid "cancelled."
msgstr "скасовано."

#: includes/class-simple-storage-jobs.php:151
#: includes/class-simple-storage-jobs.php:163
msgid "There is no running job."
msgstr "Немає задачі, що виконується."

#: includes/class-simple-storage-jobs.php:156
msgid "The job is already being processed in another request."
msgstr "Задача вже виконується в іншому запиті."

#. translators: 1: phase name, 2: number of files.
#: includes/class-simple-storage-jobs.php:259
#, php-format
msgid "%1$s: %2$d files failed; see the error list."
msgstr "%1$s: файлів з помилкою — %2$d; див. список помилок."

#: includes/class-simple-storage-jobs.php:278
msgid "finished."
msgstr "завершено."

#. translators: %d: number of files.
#: includes/class-simple-storage-jobs.php:281
#, php-format
msgid "%d file failed."
msgid_plural "%d files failed."
msgstr[0] "%d файл з помилкою."
msgstr[1] "%d файли з помилкою."
msgstr[2] "%d файлів з помилкою."

#. translators: %s: failed test step and its message.
#: includes/class-simple-storage-jobs.php:400
#, php-format
msgid "Connection test failed: %s"
msgstr "Перевірка з’єднання не вдалася: %s"

#. translators: %d: number of files.
#: includes/class-simple-storage-jobs.php:515
#, php-format
msgid "%d files that no longer exist were removed from the index."
msgstr "З індексу прибрано файлів, яких більше немає: %d."

#. translators: %d: number of files.
#: includes/class-simple-storage-jobs.php:623
#, php-format
msgid "The storage folder looks empty although %d files are recorded there; the index was left unchanged. Check the site folder setting."
msgstr "Тека в сховищі виглядає порожньою, хоча за індексом там файлів: %d. Індекс залишено без змін — перевірте налаштування теки сайту."

#. translators: %d: number of files.
#: includes/class-simple-storage-jobs.php:636
#, php-format
msgid "%d recorded files were not found in the storage listing; the index was left unchanged. Index again later, and check the storage panel if this repeats."
msgstr "Записаних файлів, яких немає в списку сховища: %d. Індекс залишено без змін — проіндексуйте ще раз пізніше, а якщо повториться, перевірте панель сховища."

#. translators: 1: number of files, 2: list of paths.
#: includes/class-simple-storage-jobs.php:667
#, php-format
msgid "%1$d files exist neither locally nor in the storage: %2$s"
msgstr "Файлів, яких немає ні локально, ні в сховищі: %1$d — %2$s"

#. translators: %s: error message.
#: includes/class-simple-storage-jobs.php:685
#, php-format
msgid "The storage could not be read, only local files were indexed: %s"
msgstr "Не вдалося прочитати сховище, проіндексовано лише локальні файли: %s"

#. translators: 1: file extension, 2: error message.
#: includes/class-simple-storage-jobs.php:765
#, php-format
msgid "Files with the extension .%1$s are not served from the storage and stay local: %2$s"
msgstr "Файли з розширенням .%1$s не віддаються зі сховища й лишаються на сайті: %2$s"

#: includes/class-simple-storage-jobs.php:781
msgid "Serving from the storage is off, so local copies were kept."
msgstr "Віддачу зі сховища вимкнено, тому локальні копії збережено."

#. translators: %s: file extension.
#: includes/class-simple-storage-jobs.php:794
#, php-format
msgid "Serving .%s files from the storage is not verified, so the local file was kept."
msgstr "Віддачу файлів .%s зі сховища не перевірено, тому локальний файл збережено."

#. translators: %d: number of files.
#: includes/class-simple-storage-jobs.php:810
#, php-format
msgid "%d files are still stored locally; run the transfer again after checking the errors."
msgstr "Файлів, що досі зберігаються локально: %d. Перевірте помилки й запустіть перенесення ще раз."

#. translators: 1: required size, 2: free size.
#: includes/class-simple-storage-jobs.php:830
#, php-format
msgid "Not enough disk space: %1$s is needed, %2$s is free."
msgstr "Недостатньо місця на диску: потрібно %1$s, вільно %2$s."

#: includes/class-simple-storage-jobs.php:889
msgid "All files are back in WordPress. If the site is behind Cloudflare or another CDN, purge its cache so that cached redirects to the storage disappear."
msgstr "Усі файли повернулися у WordPress. Якщо сайт працює через Cloudflare чи інший CDN, очистіть його кеш, щоб зникли закешовані переадресації на сховище."

#. translators: %d: number of files.
#: includes/class-simple-storage-jobs.php:892
#, php-format
