#: includes/class-simple-storage-jobs.php:1720
#: includes/class-simple-storage-jobs.php:1722
#: includes/class-simple-storage-jobs.php:1731
msgid "Finishing"
msgstr "Завершення"

#: includes/class-simple-storage-jobs.php:1717
